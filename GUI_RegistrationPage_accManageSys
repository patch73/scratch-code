package labActs;
import java.awt.*;
import java.io.*;
import javax.swing.*;

public class AccountManagementSystem_Register extends JFrame {
	static JLabel lbltitle, lblusername, lblpass, lblname;
	static JTextField txtusername, txtpass, txtname;
	static JButton btnregister, btnclear, btnback;
	
	AccountManagementSystem_Register(){
		setLayout(null);
		setDefaultCloseOperation(EXIT_ON_CLOSE);
		setTitle("Accounr Management System - Register");
		setSize(520,350);
		setResizable(false);
		getContentPane().setBackground(new Color (255, 255, 240)); 
		
		//TITLE
		lbltitle = new JLabel ("CREATE NEW ACCOUNT");
		lbltitle.setFont(new Font ("Arial", Font.BOLD, 15));
		add(lbltitle).setBounds(160, 30, 200, 30);
		
		//USERNAME
		lblusername = new JLabel ("Username:");
		add(lblusername).setBounds(50, 80, 100, 30);
		txtusername = new JTextField ();
		txtusername.setBorder(BorderFactory.createLineBorder(new Color(211, 211, 211), 2, true));
		add(txtusername).setBounds(160, 80, 300, 30);
		
		//PASSWORD
		lblpass = new JLabel ("Password:");
		add(lblpass).setBounds(50, 130, 100, 30);
		txtpass = new JTextField ();
		txtpass.setBorder(BorderFactory.createLineBorder(new Color(211, 211, 211), 2, true));
		add(txtpass).setBounds(160, 130, 300, 30);
		
		//FULLNAME
		lblname = new JLabel ("Full Name:");
		add(lblname).setBounds(50, 180, 100, 30);
		txtname = new JTextField ();
		txtname.setBorder(BorderFactory.createLineBorder(new Color (211, 211, 211), 2, true));
		add(txtname).setBounds(160, 180, 300, 30);
		
		//BUTTON FOR REGISTER
		btnregister = new JButton ("Register");
		btnregister.setBackground(new Color (0, 100, 148));
		btnregister.setBorderPainted(false);
		btnregister.setForeground(Color.WHITE);
		add(btnregister).setBounds(60, 240, 100, 30);
		
		//BUTTON FOR CLEAR
		btnclear = new JButton ("Clear");
		btnclear.setBackground(new Color (255, 206, 27));
		btnclear.setBorderPainted(false);
		btnclear.setForeground(Color.WHITE);
		add(btnclear).setBounds(205, 240, 100, 30);
		
		//BUTTON FOR CLEAR
		btnback = new JButton ("Back");
		btnback.setBackground(new Color (105, 105, 105));
		btnback.setBorderPainted(false);
		btnback.setForeground(Color.WHITE);
		add(btnback).setBounds(350, 240, 100, 30);
		
		
		
		btnregister.addActionListener(e->{
			register();
		});
		
		btnclear.addActionListener(e->{
			clear();
		});
		
		
		btnback.addActionListener(e->{
			
			//ibutang diri ang class name sa LOG IN PAGE
			
			dispose();
			
		});
		
		
		
		setVisible(true);
	}
	public void register () {
		try (FileWriter f = new FileWriter ("users.txt", true)) {
			
			String username = txtusername.getText();
			String password = txtpass.getText();
			String fullname = txtname.getText();
			
			String record = username + "," + password + "," + fullname + "\n";
			
			f.write(record);
			
			JOptionPane.showMessageDialog(null, "Registered Successfully!");
			
		}catch (IOException e) { }
	};
	
	
	public void clear () {
		txtusername.setText("");
		txtpass.setText("");
		txtname.setText("");
	}



	public static void main (String[] args) {
		new AccountManagementSystem_Register();
		
		
	}
}
