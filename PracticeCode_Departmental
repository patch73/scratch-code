package MY;

import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.util.ArrayList;
import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JOptionPane;
import javax.swing.JScrollPane;
import javax.swing.JTable;
import javax.swing.JTextField;
import javax.swing.table.DefaultTableModel;

public class DepartmentalGUI_prac extends JFrame {
	
	static JLabel lblname, lblage;
	static JTextField txtname, txtage;
	static JButton btnadd, btnup, btndel, btnclear;
	static DefaultTableModel model;
	static JTable table;
	static JScrollPane sp;
	
	DepartmentalGUI_prac (){
		setLayout(null);
		setSize(400,400);
		setTitle("Name Inputer");
		setResizable(false);
		setLocationRelativeTo(null);
		setDefaultCloseOperation(EXIT_ON_CLOSE);
		
		lblname = new JLabel ("Name:");
		add(lblname).setBounds(30,40,100,30);
		txtname = new JTextField();
		add(txtname).setBounds(30,65,100,20);
		
		lblage = new JLabel ("Age:");
		add(lblage).setBounds(30,90,100,30);
		txtage = new JTextField();
		add(txtage).setBounds(30,115,100,20);
		
		
		
		btnadd = new JButton ("Add");
		add(btnadd).setBounds(30, 150, 100, 25);
		
		btnup = new JButton ("Update");
		add(btnup).setBounds(30, 190, 100, 25);
		
		btndel = new JButton ("Delete");
		add(btndel).setBounds(30, 230, 100, 25);
		
		btnclear = new JButton ("Clear");
		add(btnclear).setBounds(30, 270, 100, 25);
		
		
		btnadd.addActionListener(e->{
			
			if (condition()) {
				add();
				read();
			}
			
			
		});
		
		btnup.addActionListener(e-> {
			
			if (condition()) {
				update();
				read();

			}
		});
		
		btndel.addActionListener(e->{
			delete();
			read();
		});
		
		btnclear.addActionListener(e->{
			clear();
			
		});
		
		
		String[] columns = {"Name", "Age"};
		model = new DefaultTableModel(columns,0);
		table = new JTable(model);
		sp = new JScrollPane(table);
		add(sp).setBounds(150, 40, 200, 200);
		
		read();
		table.addMouseListener(new MouseAdapter() {
			public void mouseClicked (MouseEvent e) {
				int row = table.getSelectedRow();
				if (row != -1) {
					txtname.setText(model.getValueAt(row, 0).toString());
					txtage.setText(model.getValueAt(row, 1).toString());
				}
			}
		});
		
		
		setVisible(true);
	}
	
	public static void add() {
		try(FileWriter f = new FileWriter ("rec.txt", true)) {
			

			String info = txtname.getText() + "#" + txtage.getText() + "\n";
			
			f.write(info);			
			
			JOptionPane.showMessageDialog(null, "Successfully added!");
			
		} catch (IOException e) { 
		}
	}
	
	public static void update () {
		int selectedRow = table.getSelectedRow();
		if (selectedRow == -1) {
			JOptionPane.showMessageDialog(null, "Pls select a record to update.");
			return;
		}
	
		
		ArrayList<String> lines = new ArrayList<> ();
		try(BufferedReader br = new BufferedReader (new FileReader ("rec.txt"))) {
			String line;
			int rowIndex = 0;
			
			while ((line = br.readLine()) != null) {
				if (rowIndex == selectedRow) {
					String update = txtname.getText() + "#" + txtage.getText();
					lines.add(update);
	
				} else {
					lines.add(line);
				} rowIndex++;
			}
			
		try (BufferedWriter bw = new BufferedWriter (new FileWriter ("rec.txt"))) {
			
			for (String record : lines) bw.write(record);

		}
			
			JOptionPane.showMessageDialog(null, "Updated successfully!");
			
		}catch (IOException ex) {
			System.out.print(ex);
		}
	
	}
	
	public static void delete() {
		int selectedRow = table.getSelectedRow();
		if (selectedRow == -1) {
			JOptionPane.showMessageDialog(null, "Pls select a record to delete");
			return;
		}
		
		int confirm = JOptionPane.showConfirmDialog(null,"Are you sure you want to delete this? ", "Confirm delete", JOptionPane.YES_NO_OPTION);
		if (confirm == JOptionPane.NO_OPTION)
			return;
		
		
		ArrayList<String> lines = new ArrayList<>();
		try(BufferedReader br = new BufferedReader (new FileReader ("rec.txt"))) {
			String line;
			int rowIndex = 0;
			
			while ((line = br.readLine()) != null) {
				if (selectedRow != rowIndex) {
					lines.add(line);
				} rowIndex++;
			}
			
		}catch (IOException ex ) {
			System.out.println(ex);
		}
		
		try (BufferedWriter bw = new BufferedWriter (new FileWriter ("rec.txt"))) {
			
			for (String record : lines) bw.write(record);	
			
			JOptionPane.showMessageDialog(null, "Deleted successfully!");

		} catch (IOException ex) {
			System.out.println(ex);
		}
		
	}
	
	public static void clear() {
		txtname.setText("");
		txtage.setText("");
	}
	
	public static void read() {
		model.setRowCount(0);
		
		try(BufferedReader br = new BufferedReader (new FileReader ("rec.txt"))){
			String line;
			
			while ((line = br.readLine()) != null ) {
				String[] row = line.split("#");
				model.addRow(row);
			}
			
		}catch (IOException e) {
			
		}
	}
	
	public static boolean condition() {
		if (txtname.getText().isEmpty()) {
			JOptionPane.showMessageDialog(null, "Name should not be empty");
			return false;
		}
		
		if (txtage.getText().isEmpty()) {
			JOptionPane.showMessageDialog(null, "Age should not be empty");
			return false;
		} 
		
		try {
			Integer.parseInt(txtage.getText());
		} catch (NumberFormatException e) {
		JOptionPane.showMessageDialog(null, "Age should be a number");
		return false;
		}
		
		
		return true;
	}
	
	public static void main (String[] args) {
		new DepartmentalGUI_prac();
	}
}
